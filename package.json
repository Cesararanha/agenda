{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agenda local do Cesar: PWA + API + MCP + WhatsApp, dados em SQLite no proprio Mac",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "AGENDA_SERVE_WEB=1 tsx src/server/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "agent:check": "node --import tsx scripts/agent-pilot.ts check",
    "agent:eval": "node --import tsx scripts/agent-pilot.ts eval",
    "test:agent": "node --import tsx --test src/agent/pilot/*.test.ts src/agent/core/*.test.ts src/shared/*.test.ts",
    "test:agenda": "node scripts/agenda-regression.mjs",
    "test:agenda:pg": "node scripts/agenda-regression-pg.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import": "tsx scripts/db-import-sqlite.ts",
    "link": "node scripts/link.mjs",
    "tunel": "cloudflared tunnel --url http://localhost:8787",
    "whatsapp": "node scripts/whatsapp-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "whatsapp:setup": "node scripts/whatsapp-setup.mjs",
    "agent:serve": "node scripts/agent-serve.mjs",
    "agent:demo": "node --import tsx scripts/agent-core-demo.ts",
    "agent:replay": "node --import tsx scripts/agent-core-replay.ts",
    "agent:query-demo": "node --import tsx scripts/agent-query-demo.ts",
    "test:agent:api": "node scripts/agent-api-regression.mjs",
    "agent:app": "npm run build && node scripts/agent-app-demo.mjs",
    "test:agent:chat": "node scripts/agent-chat-regression.mjs",
    "test:agent:weekly": "node scripts/agent-weekly-regression.mjs",
    "agent:eval:language": "node --import tsx scripts/agent-language-eval.ts",
    "agent:eval:planning": "node --import tsx scripts/agent-planning-eval.ts",
    "agent:eval:dialogues": "node --import tsx scripts/agent-dialogue-eval.ts",
    "test:agent:changes": "node scripts/agent-changes-regression.mjs",
    "agent:eval:changes": "node --import tsx scripts/agent-change-eval.ts",
    "agent:verify": "npm run typecheck && npm run test:agent && npm run test:agent:api && npm run test:agent:chat && npm run test:agent:changes && npm run test:agent:weekly && npm run test:agenda && npm run test:agenda:pg && npm run build",
    "agent:verify:model": "npm run agent:check && npm run agent:eval:language -- --with-model && npm run agent:eval:planning && npm run agent:eval:planning -- --holdout && npm run agent:eval:dialogues && npm run agent:eval:dialogues -- --holdout && npm run agent:eval:dialogues -- --unseen && npm run agent:eval:dialogues -- --acceptance && npm run agent:eval:changes",
    "agent:eval:quick-add": "node --import tsx scripts/agent-quick-add-eval.ts",
    "test": "npm run test:agent"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fastify": "^5.2.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
