# Copie para .env e ajuste. O .env nunca vai pro git.

# --- servidor ---
AGENDA_PORT=8787
# 0.0.0.0 deixa o celular acessar pela rede local; 127.0.0.1 tranca no Mac
AGENDA_HOST=0.0.0.0
AGENDA_TZ=America/Maceio
# Caminho do banco. Padrao: ./data/agenda.db
AGENDA_DB=

# --- acesso ---
# Token exigido em TODA requisicao que nao venha do proprio Mac (celular, IA, WhatsApp).
# Gere um: openssl rand -hex 24
AGENDA_TOKEN=
# 1 = requisicao de 127.0.0.1 dispensa token (conveniencia no Mac). 0 = sempre exige.
AGENDA_ALLOW_LOCAL=1

# --- vaults (somente leitura, nada e copiado) ---
# Lista separada por virgula: rotulo=caminho
# Na conta pessoal, so o vault pessoal. O cofre do SENAI entra SO numa instancia
# rodando na conta do SENAI, nunca aqui.
AGENDA_VAULTS=pessoal=/caminho/do/seu/vault

# --- WhatsApp (Meta Cloud API) ---
# Deixe vazio para manter a integracao desligada.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# App Secret do app na Meta. Sem ele o webhook recusa TODO POST (falha fechada).
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Somente este numero pode comandar a agenda (formato internacional, so digitos)
WHATSAPP_ALLOWED_FROM=
